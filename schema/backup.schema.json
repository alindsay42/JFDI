{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alindsay42.github.io/jfdi/schema/backup.schema.json",
  "title": "J.F.D.I backup",
  "description": "Everything the app holds for the household, in one file: every profile, every programme in use, each person's training log, and the household's gyms and their equipment. The exercise library comes with the app, so it isn't included. See docs/backup.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "exportedAt", "app", "profiles", "programmes", "logs"],
  "properties": {
    "format": { "const": "jfdi-backup" },
    "formatVersion": { "const": 2 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "app": {
      "description": "The version of J.F.D.I that made the backup",
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "profiles": { "type": "array", "items": { "$ref": "profile.schema.json" } },
    "programmes": { "type": "array", "items": { "$ref": "programme.schema.json" } },
    "gyms": {
      "description": "The places the household trains, each with its equipment. The first is home. Older backups don't have this; restoring one gives home the kit the app came with",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "kit": { "$ref": "equipment.schema.json" }
        }
      }
    },
    "logs": {
      "description": "One training log per profile",
      "type": "array",
      "items": { "$ref": "log.schema.json" }
    }
  }
}
