{
  "name": "jfdi",
  "version": "0.16.0",
  "private": true,
  "description": "J.F.D.I: build training programmes and run them in the gym.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "types": "node scripts/gen-types.mjs",
    "rules": "node scripts/rules-doc.ts",
    "typecheck": "tsc",
    "validate": "node scripts/validate.mjs",
    "catalogue": "node scripts/catalogue.mjs",
    "test:formats": "node scripts/validate.mjs --self-test && node scripts/catalogue.mjs --check && node scripts/gen-types.mjs --check && node scripts/rules-doc.ts --check",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "npm run test:formats && npm run typecheck && npm run test:unit",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fake-indexeddb": "6.2.7",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
